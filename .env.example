# Telegram: заявки с формы → чат/группа
# Бот: @verandayaht_bot
# 1. Токен: @BotFather → /newbot
# 2. Chat ID: добавьте бота в группу или напишите ему /start, затем:
#    npm run telegram:chat-id
#    в ответе: message.chat.id (для группы часто отрицательное число)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HTTP-прокси для api.telegram.org (если сервер не достучается напрямую)
TELEGRAM_HTTP_PROXY=http://188.212.125.202:3128
# Relay: если VPS не может достучаться до Telegram — отправка через Vercel
TELEGRAM_RELAY_URL=https://veranda-tan.vercel.app/api/telegram-relay
TELEGRAM_RELAY_SECRET=
